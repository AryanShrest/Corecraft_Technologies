NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Contact form delivery (use a sender on a domain verified in Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=CoreCraft Website <website@corecraftnepal.com>
CONTACT_TO_EMAIL=info@corecraftnepal.com

# Distributed production rate limiting (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
